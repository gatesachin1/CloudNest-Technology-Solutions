# ─── Public (baked into the static build) ─────────────────────────────
# Canonical site URL, used for sitemap, canonical tags, Open Graph.
NEXT_PUBLIC_SITE_URL=https://cloudnesttechnologysolutions.in

# Where the contact form POSTs. Locally: run `npm run dev:contact`.
# In production: the Lambda Function URL / API Gateway URL from Terraform output.
NEXT_PUBLIC_CONTACT_ENDPOINT=http://localhost:8787/contact

# ─── Contact handler (Lambda / local server only, never NEXT_PUBLIC_) ──
# Delivery provider: "console" (log only), "ses" (production) or "smtp" (e.g. Gmail).
CONTACT_PROVIDER=console
CONTACT_TO_EMAIL=gatesachin1112@gmail.com
CONTACT_FROM_EMAIL=no-reply@cloudnesttechnologysolutions.in
AWS_REGION=ap-south-1

# SMTP (only when CONTACT_PROVIDER=smtp). Gmail: turn on 2-Step Verification, then create
# an App Password at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=gatesachin1112@gmail.com
SMTP_PASS=

# Comma-separated origins allowed to call the endpoint (CORS).
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,https://cloudnesttechnologysolutions.in,https://www.cloudnesttechnologysolutions.in

# Rate limiting: max submissions per IP per window.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600
# DynamoDB table for rate limiting in production. Leave empty locally (in-memory).
RATE_LIMIT_TABLE=
# Secret salt for hashing IPs (any long random string; use a different one in production).
RATE_LIMIT_SALT=change-me-local-only

# Local contact server port.
CONTACT_LOCAL_PORT=8787

# AWS credentials: do NOT put them here. The Lambda uses its IAM role;
# locally the AWS SDK reads your ~/.aws profile if CONTACT_PROVIDER=ses.
